{
  "name": "@ad17-2/agent",
  "version": "0.4.1",
  "description": "Lightweight agentic loop for Claude powered by Vercel AI SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p examples/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ai": "^7.0.113",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": "^2.0.57"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.62",
    "@ai-sdk/mcp": "2.0.57",
    "@ai-sdk/otel": "1.0.113",
    "@ai-sdk/provider": "4.0.18",
    "@eslint/js": "^9.39.2",
    "@langfuse/otel": "5.11.1",
    "@langfuse/vercel-ai-sdk": "5.11.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "anthropic",
    "llm",
    "tools",
    "vercel-ai-sdk"
  ],
  "author": "ad17-2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ad17-2/agent.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
