{
  "name": "@ad17-2/agent",
  "version": "0.5.0",
  "description": "Lightweight agentic loop for Claude powered by Vercel AI SDK",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p examples/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --ignore-pattern tests/fixtures/lint-violations.ts src tests examples",
    "lint:fix": "oxlint --type-aware --fix --ignore-pattern tests/fixtures/lint-violations.ts src tests examples",
    "format": "biome format --write src tests examples",
    "format:check": "biome format src tests examples",
    "example:telemetry": "pnpm build && node examples/telemetry-console.ts",
    "check:package": "bash scripts/check-package.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ai": "^7.0.113",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": "^2.0.57"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.62",
    "@ai-sdk/mcp": "2.0.57",
    "@ai-sdk/otel": "1.0.113",
    "@ai-sdk/provider": "4.0.18",
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@langfuse/otel": "5.11.1",
    "@langfuse/vercel-ai-sdk": "5.11.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@types/node": "^26.6.2",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "anthropic",
    "llm",
    "tools",
    "vercel-ai-sdk"
  ],
  "author": "ad17-2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ad17-2/agent.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
